# Salin ke .env.local untuk pengembangan, atau isi di environment container untuk produksi.
#
# Koneksi PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/audit_internal
#
# Kunci tanda tangan sesi (JWT). WAJIB diganti dengan string acak panjang di produksi.
# Contoh membuat: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=dev-insecure-secret-change-me-please-32-bytes
#
# true bila aplikasi diakses via HTTPS; false bila HTTP (mis. di belakang reverse-proxy).
SESSION_COOKIE_SECURE=false
#
# PIN per peran via environment. Bila diisi, PIN ini menang dan kolom di halaman
# "Akses" menjadi read-only (hapus variabelnya bila ingin atur dari UI).
PIN_ADMIN=123098
PIN_PRODUKSI=123456
PIN_AUDITOR=123987
